# From @BotFather after /newbot – never commit the real token
TELEGRAM_BOT_TOKEN=

# Optional – resolved from getMe() at startup if omitted
# TELEGRAM_BOT_USERNAME=YourBotUsername

# long_polling (local) | webhook (Railway)
BOT_MODE=long_polling

# Public origin for QR landings, apply redirects, funder dashboard
# Use your Railway URL in production (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Public impact/partner dashboards: live (collected analytics_events) or demo
# (staged “at scale” numbers). Recording always continues either way.
# IMPACT_STATS_MODE=live
# IMPACT_STATS_MODE=demo

# Your Telegram user id(s) – excluded from live rollups (not demo).
# Also auto-includes DEVELOPER_TELEGRAM_CHAT_ID when set (private chat = user id).
# Find yours: message @userinfobot, or check /dev after chatting with the bot.
# OPERATOR_TELEGRAM_USER_IDS=123456789

# Developer tab (/dev) – password + CAPTCHA locally and on deploy.
# Temp demo password
DEVELOPER_PASSWORD=caldev1234
# Optional; falls back to WEBHOOK_SECRET
# DEVELOPER_SESSION_SECRET=change-me-too
# Escape hatch only: skip login (blocked when PUBLIC_BASE_URL is https)
# DEVELOPER_AUTH=0

# Optional – Telegram chat for Disaster CalFresh window alerts and scan
# staleness warnings. Unset = alerts are logged to the console only.
# DEVELOPER_TELEGRAM_CHAT_ID=


# Required when BOT_MODE=webhook
# WEBHOOK_URL=https://your-app.up.railway.app
# WEBHOOK_SECRET=change-me

# SQLite path (persist on Railway volume)
DATABASE_PATH=./data/calclaim.sqlite

# Optional – partner signup / org magic-link emails (nodemailer)
# Without these, kits are written to data/mail-outbox/ for local demo.
# Google Workspace example (send as noreply alias on jay@):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=jay@jayhasty.com
# SMTP_PASS=   # Google App Password for jay@ (2FA required)
# SMTP_FROM="CalClaim <noreply@jayhasty.com>"

# America/Los_Angeles for reminders
TZ=America/Los_Angeles

# Cloudflare – required for `scripts/sync-to-cloud.sh` DNS ensure.
# Without this, calclaim.jayhasty.com can go NXDOMAIN after manual DNS edits
# and deploy used to “succeed” while the public site was unreachable.
# Token: https://dash.cloudflare.com/profile/api-tokens
#   Template “Edit zone DNS” → zone jayhasty.com
# CLOUDFLARE_API_TOKEN=
# Optional overrides:
# CLOUDFLARE_ZONE_ID=
# CALCLAIM_DNS_NAME=calclaim
# CALCLAIM_DNS_ZONE=jayhasty.com
# CALCLAIM_ORIGIN_IP=144.202.105.150
# CALCLAIM_CF_PROXIED=1

# Optional – Developer review dashboard LLM analysis (/dev)
# Without a key, scans still run link + heuristic checks.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Voice feedback transcription (Whisper) – requires OPENAI_API_KEY
# WHISPER_MODEL=whisper-1

# Optional – public Donate popup (Stripe Payment Element).
# Without these, the Donate button still opens and says donations aren’t configured.
# Dashboard (test + live): enable Cards, PayPal (connect your PayPal account),
# Apple Pay + Google Pay (Wallets), and US bank account (ACH Direct Debit).
# Webhook endpoint: POST {PUBLIC_BASE_URL}/api/donate/webhook
#   events: payment_intent.succeeded, invoice.paid, customer.subscription.deleted
# Apple Pay: add calclaim.jayhasty.com in Stripe → Settings → Payment methods →
# Apple Pay, then paste the association file into STRIPE_APPLE_PAY_ASSOCIATION
# (or save it as public/.well-known/apple-developer-merchantid-domain-association).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_APPLE_PAY_ASSOCIATION=
